# ─── Google Calendar integration ────────────────────────────────────────────
#
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — NEVER commit real credentials.
#
# VERCEL DEPLOYMENT:
#   Vercel Dashboard → Project → Settings → Environment Variables
#   Add each variable → select scopes: Production + Preview + Development
#   Use "Sensitive" option for GOOGLE_API_KEY
#
# LOCAL DEVELOPMENT:
#   cp .env.example .env.local   # then fill in real values
#
# SETUP STEPS:
#   1. console.cloud.google.com → create/select project
#   2. APIs & Services → Library → enable "Google Calendar API"
#   3. APIs & Services → Credentials → Create API Key
#      → Restrict to "Google Calendar API" only
#   4. Google Calendar → Settings → [Your calendar]
#      → Access permissions → tick "Make available to public"
#   5. Copy Calendar ID from Settings → Integrate Calendar
#      (looks like: abc123@group.calendar.google.com or your Gmail)
#
# OPTIONAL — Holidays in India calendar:
#   To automatically show Indian public holidays (Diwali, Holi, etc.)
#   from Google's built-in "Holidays in India" calendar:
#   1. In Google Calendar → click "+" next to "Other calendars" → Browse calendars
#   2. Search "Holidays in India" → Subscribe
#   3. Open Settings for that calendar → Integrate Calendar → copy Calendar ID
#      (looks like: en.indian#holiday@group.v.calendar.google.com)
#   4. Paste it as GOOGLE_HOLIDAY_CALENDAR_ID below
#   If left empty, the app still works — only your primary calendar events show.
# ────────────────────────────────────────────────────────────────────────────

# API Key restricted to Google Calendar API (read-only, public calendar only)
GOOGLE_API_KEY=

# Primary calendar ID — your bookings + custom festival events
# From Google Calendar → Settings → Integrate Calendar
GOOGLE_CALENDAR_ID=

# (Optional) Google "Holidays in India" subscribed calendar ID
# IMPORTANT: Wrap in double-quotes because the ID contains a # character.
# Without quotes, dotenv parsers treat # as a comment and truncate the value.
# The # is handled safely by encodeURIComponent() in the route — never trust raw env values in URLs.
GOOGLE_HOLIDAY_CALENDAR_ID="en-gb.indian#holiday@group.v.calendar.google.com"

# Timezone for display (default: Asia/Kolkata)
GOOGLE_CALENDAR_TIME_ZONE=Asia/Kolkata
